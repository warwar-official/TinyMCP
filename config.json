{
  "servers": [
    {
      "name": "spotify",
      "mcp_name": "spotify",
      "class": "providers.spotify_mcp.SpotifyMCP",
      "tools": [
        {
          "name": "search",
          "description": "Search for tracks, albums, or artists on Spotify.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "query": {"type": "string"},
              "limit": {"type": "integer"},
              "type": {
                "type": "array",
                "items": {"type": "string"}
              }
            },
            "required": ["query"]
          }
        },
        {
          "name": "playback_control",
          "description": "Control playback: play, pause, next, previous.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "action": {"type": "string", "enum": ["play", "pause", "next", "previous"]},
              "uris": {"type": "array", "items": {"type": "string"}},
              "context_uri": {"type": "string"},
              "offset": {"type": "integer"}
            },
            "required": ["action"]
          }
        },
        {
          "name": "playback_mode",
          "description": "Set playback metadata (repeat, shuffle).",
          "inputSchema": {
            "type": "object",
            "properties": {
              "repeat": {"type": "string", "enum": ["track", "context", "off"]},
              "shuffle": {"type": "boolean"}
            }
          }
        },
        {
          "name": "create_playlist",
          "description": "Create a new playlist.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "description": {"type": "string"},
              "public": {"type": "boolean"}
            },
            "required": ["name"]
          }
        },
        {
          "name": "add_to_playlist",
          "description": "Add tracks to a playlist.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "playlist_id": {"type": "string"},
              "track_uris": {"type": "array", "items": {"type": "string"}}
            },
            "required": ["playlist_id", "track_uris"]
          }
        },
        {
          "name": "remove_from_playlist",
          "description": "Remove tracks from a playlist.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "playlist_id": {"type": "string"},
              "track_uris": {"type": "array", "items": {"type": "string"}},
              "snapshot_id": {"type": "string"}
            },
            "required": ["playlist_id", "track_uris"]
          }
        },
        {
          "name": "get_playlist",
          "description": "Get playlist metadata and items.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "playlist_id": {"type": "string"}
            },
            "required": ["playlist_id"]
          }
        },
        {
          "name": "get_user_playlists",
          "description": "Get playlists owned or followed by current user.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "limit": {"type": "integer"},
              "offset": {"type": "integer"}
            }
          }
        },
        {
          "name": "get_playback_state",
          "description": "Get state of currently playing track and device.",
          "inputSchema": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "name": "get_playback_device",
          "description": "Get available output devices.",
          "inputSchema": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "name": "set_playback_device",
          "description": "Transfer playback to a specific device.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "device_id": {"type": "string"}
            },
            "required": ["device_id"]
          }
        },
        {
          "name": "get_lyrics",
          "description": "Get lyrics for a specific track.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "artist": {"type": "string"},
              "track_name": {"type": "string"}
            },
            "required": ["artist", "track_name"]
          }
        }
      ]
    },
    {
      "name": "web",
      "mcp_name": "web",
      "class": "providers.web_tools_mcp.WebToolsMCP",
      "tools": [
        {
          "name": "weather",
          "description": "Get the current weather forecast for a location.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "location": {"type": "string"}
            },
            "required": ["location"]
          }
        },
        {
          "name": "search",
          "description": "Search the web via Brave Search API.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "query": {"type": "string"},
              "count": {"type": "integer"}
            },
            "required": ["query"]
          }
        },
        {
          "name": "fetch",
          "description": "Fetch webpage content and parse tables/links/text.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "url": {"type": "string"}
            },
            "required": ["url"]
          }
        }
      ]
    },
    {
      "name": "youtube",
      "mcp_name": "youtube",
      "class": "providers.youtube_mcp.YoutubeMCP",
      "tools": [
        {
          "name": "search",
          "description": "Search YouTube for videos, channels, or playlists.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "query": {"type": "string"},
              "type": {"type": "array", "items": {"type": "string"}},
              "limit": {"type": "integer"}
            },
            "required": ["query"]
          }
        },
        {
          "name": "get_video_info",
          "description": "Get metadata for a specific YouTube video.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "videoId": {"type": "string"}
            },
            "required": ["videoId"]
          }
        },
        {
          "name": "get_channel",
          "description": "Get channel metadata given a channel ID.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "channelId": {"type": "string"}
            },
            "required": ["channelId"]
          }
        },
        {
          "name": "get_playlist",
          "description": "Get items inside a YouTube playlist.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "playlistId": {"type": "string"},
              "limit": {"type": "integer"}
            },
            "required": ["playlistId"]
          }
        },
        {
          "name": "get_transcript",
          "description": "Get the transcript/subtitles for a YouTube video URL.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "url": {"type": "string"}
            },
            "required": ["url"]
          }
        }
      ]
    }
  ]
}
